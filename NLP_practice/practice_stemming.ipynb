   "source": [
    "from nltk.stem import PorterStemmer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "3f8778de",
   "metadata": {},
   "outputs": [],
   "source": [
    "ps = PorterStemmer()\n",
    "\n",
    "words = [\"connected\", \"connecting\", \"connects\", \"connect\", \"connection\", \"connectivity\" ]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "ba7d3aff",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "connected : connect\n",
      "connecting : connect\n",
      "connects : connect\n",
      "connect : connect\n",
      "connection : connect\n",
      "connectivity : connect\n"
     ]
    }
   ],
   "source": [
    "for word in words:\n",
    "    print(word + \" : \" + ps.stem(word)) "
   ]
  },
